class CustomDropDown extends HTMLElement {
    connectedCallback() {
         const name = this.getAttribute("name") || "select";
         const height = this.getAttribute("height") || "300px";
         const width =this.getAttribute("width") || "300px";

         const options = Array.from(this.querySelectorAll("menu-item")).map(opt => ({
           value: opt.getAttribute("value"),
           text: opt.textContent,
           selected: opt.hasAttribute("selected")
         }));

         this.innerHTML = this.renderDropdown(name, height, width, options);
         this.attachSearchFilter(name);
         this.attachSelectClearAll(name);
         this.updateItemCount();
    }

    renderDropdown(name, height, width, options) {
         const listItems = options.map((item, index) => `
             <li class="list-group-item">
                 <div class="form-check">
                     <input class="form-check-input" type="checkbox" name="${name}" id="${name}${index}" value="${item.value}" ${item.selected ? "checked" : ""}>
                     <label class="form-check-label" for="${name}${index}">
                         <span>${item.text}</span>
                     </label>
                 </div>
               </li>
         `).join("");

         return `
         <div class="dropdown">
             <button class="btn btn-outline border border-primary bg-light dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                 Select from the list...
             </button>
             <div class="dropdown-menu">
                 <div class="input-group mb-2 px-2">
                   <input type="text" class="form-control" placeholder="Search" aria-label="Search">
                   <label class="input-group-text"><i class="bi bi-search"></i></label>
                   <button class="btn btn-outline-secondary clear-btn" type="button"><i class="bi bi-x-circle"></i></button>
                 </div>
                 <div class="d-flex justify-content-between px-2 mb-2" >
                   <button type="button" class="btn btn-sm btn-outline-primary select-all">Select All</button>
                   <button type="button" class="btn btn-sm btn-outline-danger clear-all">Clear All</button>
                 </div>
                 <ul class="list-group list-group-flush overflow-auto" style="max-height: ${height}; min-width: ${width};">
                     ${listItems}
                  </ul>
             </div>
           </div>
         `;
        }

    attachSearchFilter(name) {
         const input = this.querySelector("input.form-control");
         const clearBtn = this.querySelector(".clear-btn");
         const listItems = this.querySelectorAll("li.list-group-item");

         input.addEventListener("input", () => {
           const term = input.value.toLowerCase();

           listItems.forEach(li => {
             const labelText = li.innerText.toLowerCase();
             const match = labelText.includes(term);

             if (!match) {
               li.classList.add("d-none");
             } else {
               li.classList.remove("d-none");
             }
           });
         });

         clearBtn?.addEventListener("click", () => {
           input.value = "";
           input.dispatchEvent(new Event("input"));
         });
    }

    updateItemCount() {
         const btn = this.querySelector("button.dropdown-toggle");
         const selected = this.querySelectorAll("input[type='checkbox']:checked").length;
         btn.innerText = selected === 0 ? "Select from the list..." : `${selected} selected`;
    }

    attachSelectClearAll(name) {

         const selectAllBtn = this.querySelector(".select-all");
         const clearAllBtn = this.querySelector(".clear-all");
         const checkboxes = this.querySelectorAll(`input[type='checkbox'][name='${name}']`);

         checkboxes.forEach(cb =>
             cb.addEventListener("click", () => { this.updateItemCount(); })
         );

         selectAllBtn?.addEventListener("click", () => {
           checkboxes.forEach(cb => cb.checked = true);
           this.updateItemCount();
         });

         clearAllBtn?.addEventListener("click", () => {
           checkboxes.forEach(cb => cb.checked = false);
           this.updateItemCount();
         });
    }
}

customElements.define('custom-dropdown', CustomDropDown);

